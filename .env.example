# Copy this file to .env on the deployment server.
# Replace every CHANGE_ME value before starting production.
# Never commit the real .env file.

CORS_ORIGINS=http://localhost:5192,http://127.0.0.1:5192,http://YOUR_LAN_IP:5192
DATABASE_URL=postgresql+psycopg://dt_chat_admin:dt_chat_password@postgres:5432/dt_live_chat
JWT_SECRET=replace-with-a-long-random-secret
LIVEKIT_API_KEY=dtlive
LIVEKIT_API_SECRET=replace-with-at-least-32-characters
LIVEKIT_NODE_IP=YOUR_LAN_IP
LIVEKIT_PUBLIC_URL=ws://YOUR_LAN_IP:17900
LIVEKIT_SIGNAL_PORT=17900
LIVEKIT_TCP_PORT=17902
LIVEKIT_UDP_PORT=17901
POSTGRES_DB=dt_live_chat
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_USER=dt_chat_admin
REDIS_URL=redis://redis:6379/0
VITE_API_URL=
VITE_LIVEKIT_SIGNAL_PORT=17900
VITE_WS_URL=
ZOOM_VIDEO_SDK_KEY=
ZOOM_VIDEO_SDK_SECRET=CHANGE_ME
ZOOM_VIDEO_SESSION_PASSWORD=CHANGE_ME

OLLAMA_BASE_URL=http://host.docker.internal:11434
AI_MODEL=qwen3:8b
AI_FACULTY_GRACE_SECONDS=60
AI_MAX_CONTEXT_CHARS=18000

AI_WORKBOOK_MODEL=qwen3.5:9b

AI_MEDICAL_FALLBACK_MODEL=medgemma:27b

AI_GENERAL_FALLBACK_MODEL=qwen3.5:9b

AI_MIN_GROUNDING_SCORE=8
